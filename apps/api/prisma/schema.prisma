generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DELIVERY_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CheckoutSessionStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  EXPIRED
  CANCELLED
}

// Separate from OrderStatus on purpose (dailybasket-orders-order-tracking.md
// §4-5) — order is a commerce concern, delivery is a logistics concern. The
// admin status-transition endpoint advances both together for now since
// Independent of OrderStatus (Order = commerce, Delivery = logistics —
// dailybasket-delivery-partner-operations.md). A Delivery row is created
// alongside the Order at PENDING_ASSIGNMENT; it only starts moving once an
// admin assigns a partner. OrderStatus.OUT_FOR_DELIVERY/DELIVERED are now
// set as a *side effect* of this machine reaching OUT_FOR_DELIVERY/DELIVERED
// (see OrdersService), not directly admin-settable past PACKED.
enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
  FAILED
}

enum DeliveryPartnerStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

// BUSY is system-set (the moment a partner accepts a delivery, cleared when
// it ends), never partner-toggled — see the doc's "Availability" section.
enum DeliveryPartnerAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum DeliveryFailureReason {
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  CUSTOMER_REFUSED
  UNABLE_TO_CONTACT
  OTHER
}

// Distinct from DeliveryFailureReason — this is the partner declining an
// assignment before ever accepting it, not a failed-after-accepting delivery.
enum DeliveryRejectionReason {
  TOO_FAR
  ALREADY_BUSY
  VEHICLE_ISSUE
  OTHER
}

// PENDING here means "assigned, awaiting the partner's accept/reject" — one
// row per assignment attempt, so reassigning never overwrites history (doc:
// "Never overwrite assignment history"). EXPIRED is distinct from REJECTED —
// the partner never responded within the accept window, rather than
// actively declining (see DeliveryService's accept-window cron). Kept
// separate so a future "missed too many, warn/penalize" feature can count
// EXPIRED specifically without conflating it with an explicit reject.
enum DeliveryAssignmentOutcome {
  PENDING
  ACCEPTED
  REJECTED
  REASSIGNED
  EXPIRED
}

enum OrderEventType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_CONFIRMED
  PICKING_STARTED
  ORDER_PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  ORDER_CANCELLED
}

enum OrderEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  ORGANIC
  GLUTEN_FREE
  SUGAR_FREE
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
}

model User {
  id              String     @id @default(uuid())
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  phone           String?
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  passwordHash    String     @map("password_hash")
  profileImageUrl String?    @map("profile_image_url")
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  // Seeded demo/showcase accounts — never touched by the visitor-data TTL cleanup job.
  isSystem        Boolean    @default(false) @map("is_system")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  addresses               Address[]
  orders                  Order[]
  carts                   Cart[]
  checkoutSessions        CheckoutSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  couponRedemptions       CouponRedemption[]
  favorites               Favorite[]
  productViews            ProductView[]
  deliveryPartner         DeliveryPartner?

  @@map("users")
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PACKED
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
}

// In-app only — authenticated customers only (dailybasket-orders-order-tracking.md
// §18: "recommended initial channels: Email, In-app"). Guests get email only,
// since there's no account to attach a feed to.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  orderId   String?          @map("order_id")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  label            AddressLabel @default(HOME)
  recipientName    String       @map("recipient_name")
  phone            String
  line1            String
  line2            String?
  landmark         String?
  city             String
  state            String
  country          String       @default("India")
  postalCode       String       @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String?      @map("formatted_address")
  isDefault        Boolean      @default(false) @map("is_default")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String         @id @default(uuid())
  parentId    String?        @map("parent_id")
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?        @map("image_url")
  sortOrder   Int            @default(0) @map("sort_order")
  status      CategoryStatus @default(ACTIVE)
  // Seed catalog data, protected from edit/delete by anyone below SUPER_ADMIN
  // and exempt from the visitor-data TTL cleanup job.
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  categoryId      String        @map("category_id")
  // Plain optional label, not a managed entity — Zepto/Blinkit don't model brand
  // as a first-class schema either; some products carry one, most don't.
  brand           String?
  name            String
  slug            String        @unique
  description     String?
  ingredients     String?
  nutritionalInfo Json?         @map("nutritional_info")
  dietaryInfo     DietaryTag[]  @map("dietary_info")
  countryOfOrigin String?       @map("country_of_origin")
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false) @map("is_featured")
  // Seed catalog data — protection/exemption same as Category.isSystem.
  // Variants and images aren't flagged individually; they inherit protection
  // from their parent product to avoid a duplicated flag drifting out of sync.
  isSystem        Boolean       @default(false) @map("is_system")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  favorites  Favorite[]
  views      ProductView[]

  @@index([categoryId])
  @@index([status, isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String        @id @default(uuid())
  productId      String        @map("product_id")
  skuCode        String        @unique @map("sku_code")
  barcode        String?       @unique
  label          String
  quantity       Int
  unit           Unit
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  status         VariantStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  product              Product               @relation(fields: [productId], references: [id])
  inventory            Inventory?
  cartItems            CartItem[]
  orderItems           OrderItem[]
  checkoutReservations CheckoutReservation[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String    @id @default(uuid())
  variantId        String    @unique @map("variant_id")
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  reorderLevel     Int       @default(10) @map("reorder_level")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}

model Cart {
  id        String     @id @default(uuid())
  // Null for a guest cart, identified instead by the cart's own id carried
  // as an opaque value in an HTTP-only cookie — see AGENTS.md cart doc.
  userId    String?    @map("user_id")
  status    CartStatus @default(ACTIVE)
  // UX-only, like the rest of CartSummary's totals — checkout revalidates
  // this coupon against live rules, never trusts what the cart shows.
  couponId  String?    @map("coupon_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  user             User?             @relation(fields: [userId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid())
  cartId    String    @map("cart_id")
  variantId String    @map("variant_id")
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

// Product/category-scoped eligibility is intentionally not modeled — every
// coupon here is store-wide, matching the doc's own SAVE100 example. Adding
// scoped eligibility is a real feature (a join table + matching logic), not
// a field, and nothing has asked for it yet.
model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Decimal            @map("discount_value") @db.Decimal(10, 2)
  // Only meaningful for PERCENTAGE — caps the discount in rupees so "20% off"
  // can't blow past a sane ceiling. Ignored for FLAT (the flat value already
  // is the cap).
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderValue     Decimal?           @map("min_order_value") @db.Decimal(10, 2)
  // Null on either = unlimited. usedCount is the atomic counter incremented
  // on redemption (checked with a WHERE guard, same affected-row-count
  // pattern as inventory reservation) — usageLimitPerUser is enforced
  // separately via CouponRedemption, since a global counter can't answer
  // "has this specific customer already used it."
  usageLimit        Int?               @map("usage_limit")
  usageLimitPerUser Int?               @map("usage_limit_per_user")
  usedCount         Int                @default(0) @map("used_count")
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz
  isActive          Boolean            @default(true) @map("is_active")
  // Admin-curated — shown inline on the cart page without opening the full
  // "available offers" list. Purely a display flag, no effect on eligibility.
  isFeatured        Boolean            @default(false) @map("is_featured")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  orders           Order[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  redemptions      CouponRedemption[]

  @@map("coupons")
}

// One row per successful redemption — the only reliable way to answer
// "has this customer already used this coupon" (a global usedCount counter
// can't answer a per-customer question). Guests are tracked by email, same
// guest/account split used everywhere else in this schema.
model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String   @map("coupon_id")
  userId     String?  @map("user_id")
  guestEmail String?  @map("guest_email")
  orderId    String   @unique @map("order_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@index([couponId, guestEmail])
  @@map("coupon_redemptions")
}

// Singleton — always exactly one row, addressed by the fixed id below
// (SettingsService.SINGLETON_ID), never queried by any other key. A single
// typed row rather than a generic key-value table: this is an admin CRUD
// app, not a plugin platform, so a fixed schema is more type-safe and no
// less flexible for the settings that actually exist.
enum HandlingChargeType {
  FIXED
  PERCENTAGE
}

// No GST/tax modeling — product prices are tax-inclusive (the MRP
// convention every quick-commerce app already uses), and a per-category
// rate would need per-line tax breakdown the moment a cart mixes categories
// at different rates. Not worth the complexity for a price that's already
// final.
model SystemSettings {
  id                    String   @id @default("default")
  deliveryFee           Decimal  @default(40) @map("delivery_fee") @db.Decimal(10, 2)
  // Null = disabled — delivery is never free regardless of order size.
  freeDeliveryThreshold Decimal? @map("free_delivery_threshold") @db.Decimal(10, 2)

  // FIXED: handlingChargeValue is a flat ₹ amount, handlingChargeMaxAmount
  // unused. PERCENTAGE: handlingChargeValue is a % of subtotal, charged
  // amount is capped at handlingChargeMaxAmount (same min(percent, cap)
  // pattern as a PERCENTAGE coupon's maxDiscountAmount).
  handlingChargeType         HandlingChargeType @default(FIXED) @map("handling_charge_type")
  handlingChargeValue        Decimal            @default(0) @map("handling_charge_value") @db.Decimal(10, 2)
  handlingChargeMaxAmount    Decimal?           @map("handling_charge_max_amount") @db.Decimal(10, 2)
  // Promotional waiver — e.g. "free during launch week". Not the same as
  // charging ₹0: the customer still sees the original amount struck through
  // plus the reason, rather than the fee just silently not existing.
  handlingChargeWaivedUntil  DateTime?          @map("handling_charge_waived_until") @db.Timestamptz
  handlingChargeWaiverReason String?            @map("handling_charge_waiver_reason")

  // Hard checkout kill-switch — CheckoutService.start() refuses new sessions
  // while true. Does not affect already-placed orders or admin access.
  maintenanceMode Boolean   @default(false) @map("maintenance_mode")
  bannerText      String?   @map("banner_text")
  supportEmail    String?   @map("support_email")
  supportPhone    String?   @map("support_phone")
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model Order {
  id          String  @id @default(uuid())
  // Human-facing identifier (DB-YYYYMMDD-NNNNNN), generated from the
  // order_number_seq Postgres sequence at creation — the UUID id is never
  // shown to customers (dailybasket-orders-order-tracking.md §3).
  orderNumber String  @unique @map("order_number")
  // Null for a guest order — see CheckoutSession for the same guest/user split as Cart.
  userId      String? @map("user_id")
  // Traceability only — the fields below are the authoritative snapshot per
  // AGENTS.md/checkout doc, since a saved address can change or be deleted later.
  addressId   String? @map("address_id")
  couponId    String? @map("coupon_id")

  recipientName    String  @map("recipient_name")
  phone            String
  line1            String
  line2            String?
  landmark         String?
  city             String
  state            String
  country          String  @default("India")
  postalCode       String  @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String? @map("formatted_address")

  // Contact for a guest order — authenticated orders use user.email instead.
  guestEmail String? @map("guest_email")

  status         OrderStatus @default(CONFIRMED)
  subtotal       Decimal     @db.Decimal(10, 2)
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  handlingCharge Decimal     @default(0) @map("handling_charge") @db.Decimal(10, 2)
  tax            Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?   @updatedAt @map("updated_at") @db.Timestamptz

  user             User?             @relation(fields: [userId], references: [id])
  address          Address?          @relation(fields: [addressId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  payment          Payment?
  delivery         Delivery?
  events           OrderEvent[]
  notifications    Notification[]
  couponRedemption CouponRedemption?
  checkoutSession  CheckoutSession?

  @@map("orders")
}

model OrderEvent {
  id        String          @id @default(uuid())
  orderId   String          @map("order_id")
  type      OrderEventType
  // Free-text context — e.g. the cancellation reason.
  message   String?
  actorType OrderEventActor @map("actor_type")
  actorId   String?         @map("actor_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  variantId String @map("variant_id")

  // Snapshots — an order is a historical record, catalog data is mutable.
  productNameSnapshot String @map("product_name_snapshot")
  variantNameSnapshot String @map("variant_name_snapshot")
  skuSnapshot         String @map("sku_snapshot")

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  // Nullable + independently locatable via checkoutSessionId — a payment can
  // capture before the Order row exists (see checkout doc: "payment succeeds
  // but order creation fails must be recoverable").
  orderId           String?       @unique @map("order_id")
  checkoutSessionId String?       @unique @map("checkout_session_id")
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(10, 2)
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  order           Order?           @relation(fields: [orderId], references: [id])
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  @@map("payments")
}

model CheckoutSession {
  id         String                @id @default(uuid())
  cartId     String                @map("cart_id")
  userId     String?               @map("user_id")
  guestEmail String?               @map("guest_email")
  status     CheckoutSessionStatus @default(PENDING)

  // Address snapshot — set via POST /checkout/address, either copied from a
  // saved Address or guest-entered directly. Same shape as Order's snapshot.
  savedAddressId   String? @map("saved_address_id")
  recipientName    String? @map("recipient_name")
  phone            String?
  line1            String?
  line2            String?
  landmark         String?
  city             String?
  state            String?
  country          String? @default("India")
  postalCode       String? @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String? @map("formatted_address")

  // Inherited from the cart at start() as the customer's stated intent, then
  // independently revalidated (min order, expiry, usage limits...) each time
  // createPayment() recomputes pricing — never trusted as-is.
  couponId String? @map("coupon_id")

  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  discount       Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  handlingCharge Decimal @default(0) @map("handling_charge") @db.Decimal(10, 2)
  tax            Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)

  orderId String? @unique @map("order_id")

  // Session expiry (~15 min) and reservation expiry (~10 min) are separate
  // per the checkout doc — the reservation can lapse first, forcing
  // re-validation, even while the session itself is still alive.
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  reservationExpiresAt DateTime? @map("reservation_expires_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  cart         Cart                  @relation(fields: [cartId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])
  coupon       Coupon?               @relation(fields: [couponId], references: [id])
  order        Order?                @relation(fields: [orderId], references: [id])
  payment      Payment?
  reservations CheckoutReservation[]

  @@index([userId])
  @@index([cartId])
  @@map("checkout_sessions")
}

model CheckoutReservation {
  id                String  @id @default(uuid())
  checkoutSessionId String  @map("checkout_session_id")
  variantId         String  @map("variant_id")
  quantity          Int
  // Price at the moment stock was reserved — this is what Razorpay actually
  // charged, so order creation reads it back instead of re-deriving from the
  // (possibly since-changed) live catalog price.
  unitPrice         Decimal @map("unit_price") @db.Decimal(10, 2)

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([checkoutSessionId, variantId])
  @@map("checkout_reservations")
}

model Delivery {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")

  // Current partner only — full assignment history (including rejections
  // and reassignments) lives in DeliveryAssignment, never overwritten.
  deliveryPartnerId String?        @map("delivery_partner_id")
  status            DeliveryStatus @default(PENDING_ASSIGNMENT)

  currentLatitude  Float?    @map("current_latitude")
  currentLongitude Float?    @map("current_longitude")
  lastLocationAt   DateTime? @map("last_location_at") @db.Timestamptz
  deliveryNotes    String?   @map("delivery_notes")

  // Plaintext, unlike EmailVerificationToken/PasswordResetToken — this isn't
  // an auth credential, it's a handoff code the customer has to read out to
  // the partner, so it must be recoverable to display on the order/tracking
  // page, not just verifiable. Low blast radius if leaked (confirms receipt
  // of one order, no account access) — never returned to the delivery
  // partner's own endpoints though, see DeliveryService.myActive().
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at") @db.Timestamptz

  failureReason   DeliveryFailureReason?   @map("failure_reason")
  // Mirrors DeliveryAssignment's own copy (the permanent per-attempt record)
  // — this one only ever reflects the latest attempt, same as failureReason,
  // and is reset by adminAssign() on every (re)assign.
  rejectionReason DeliveryRejectionReason? @map("rejection_reason")
  // Free text, required by the frontend only when rejectionReason is OTHER —
  // the enum alone doesn't say anything for that case.
  rejectionNote   String?                  @map("rejection_note")

  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz
  pickedUpAt       DateTime? @map("picked_up_at") @db.Timestamptz
  outForDeliveryAt DateTime? @map("out_for_delivery_at") @db.Timestamptz
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz
  failedAt         DateTime? @map("failed_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  order           Order                @relation(fields: [orderId], references: [id])
  deliveryPartner DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id])
  assignments     DeliveryAssignment[]

  @@index([deliveryPartnerId])
  @@map("deliveries")
}

model DeliveryPartner {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Account-level (admin-controlled) vs operational (partner-controlled) —
  // kept as two separate fields on purpose, see the doc's "Availability"
  // section: a SUSPENDED partner can't just go AVAILABLE to get around it.
  status             DeliveryPartnerStatus       @default(PENDING_APPROVAL)
  availabilityStatus DeliveryPartnerAvailability @default(OFFLINE) @map("availability_status")
  // When they last went OFFLINE -> AVAILABLE; null while OFFLINE/BUSY.
  // Admin's assignment picker sorts by this ascending — longest-idle-first
  // FIFO, see dailybasket-delivery-partner-operations.md "Assignment".
  availableSince DateTime? @map("available_since")
  // Bumped on every availability toggle (either direction) — unlike
  // availableSince, this is never cleared, so the admin partner list can
  // show "last seen" for someone who's currently OFFLINE.
  lastSeenAt DateTime? @map("last_seen_at")

  vehicleType      String?   @map("vehicle_type")
  vehicleNumber    String?   @map("vehicle_number")
  currentLatitude  Float?    @map("current_latitude")
  currentLongitude Float?    @map("current_longitude")
  lastLocationAt   DateTime? @map("last_location_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  user        User                 @relation(fields: [userId], references: [id])
  deliveries  Delivery[]
  assignments DeliveryAssignment[]

  @@map("delivery_partners")
}

// One row per assignment attempt — reassigning creates a new row rather
// than mutating the old one, so "Partner A rejected, Partner B accepted"
// stays visible after the fact.
model DeliveryAssignment {
  id                String                    @id @default(uuid())
  deliveryId        String                    @map("delivery_id")
  deliveryPartnerId String                    @map("delivery_partner_id")
  outcome           DeliveryAssignmentOutcome @default(PENDING)
  assignedAt        DateTime                  @default(now()) @map("assigned_at") @db.Timestamptz
  respondedAt       DateTime?                 @map("responded_at") @db.Timestamptz

  // Mirrors the same-named fields on Delivery, but scoped to *this* attempt
  // — Delivery's own copies only ever reflect the current/latest attempt
  // (adminAssign() nulls them out on every reassign). Without these, a
  // delivery that failed under Partner A and was then delivered by Partner
  // B would show "Delivered" on both attempts in history, since they'd
  // share Delivery's single deliveredAt.
  pickedUpAt       DateTime?                @map("picked_up_at") @db.Timestamptz
  outForDeliveryAt DateTime?                @map("out_for_delivery_at") @db.Timestamptz
  deliveredAt      DateTime?                @map("delivered_at") @db.Timestamptz
  failedAt         DateTime?                @map("failed_at") @db.Timestamptz
  failureReason    DeliveryFailureReason?   @map("failure_reason")
  // Required by the myReject endpoint — a partner can't decline an
  // assignment without giving a reason (see DeliveryController.myReject).
  rejectionReason  DeliveryRejectionReason? @map("rejection_reason")
  rejectionNote    String?                  @map("rejection_note")

  delivery        Delivery        @relation(fields: [deliveryId], references: [id])
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryId])
  @@index([deliveryPartnerId])
  @@map("delivery_assignments")
}

// Explicit save-to-favorites — product-level, not variant-level, so a
// favorited product can be re-added with whatever variant the customer
// wants at the time (grocery variants change price/stock far more often
// than the product identity itself). Auth-only, no guest favorites.
model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// One row per (user, product) — a view upserts and bumps viewedAt rather
// than appending a new row each time, so "recently viewed" is just
// `ORDER BY viewed_at DESC LIMIT N` with no separate pruning job needed.
// Auth-only — a guest's browsing history isn't worth persisting.
model ProductView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("product_views")
}
