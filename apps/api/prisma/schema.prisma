generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DELIVERY_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CheckoutSessionStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  EXPIRED
  CANCELLED
}

// Separate from OrderStatus on purpose (dailybasket-orders-order-tracking.md
// §4-5) — order is a commerce concern, delivery is a logistics concern. The
// admin status-transition endpoint advances both together for now since
// there's no delivery-partner assignment flow yet (see delivery-partner
// doc); once that lands, a partner can advance Delivery independently.
enum DeliveryStatus {
  PENDING
  PICKING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderEventType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_CONFIRMED
  PICKING_STARTED
  ORDER_PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  ORDER_CANCELLED
}

enum OrderEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  ORGANIC
  GLUTEN_FREE
  SUGAR_FREE
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
}

model User {
  id              String     @id @default(uuid())
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  phone           String?
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  passwordHash    String     @map("password_hash")
  profileImageUrl String?    @map("profile_image_url")
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  // Seeded demo/showcase accounts — never touched by the visitor-data TTL cleanup job.
  isSystem        Boolean    @default(false) @map("is_system")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  addresses               Address[]
  orders                  Order[]
  carts                   Cart[]
  checkoutSessions        CheckoutSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  label            AddressLabel @default(HOME)
  recipientName    String       @map("recipient_name")
  phone            String
  line1            String
  line2            String?
  landmark         String?
  city             String
  state            String
  country          String       @default("India")
  postalCode       String       @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String?      @map("formatted_address")
  isDefault        Boolean      @default(false) @map("is_default")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String         @id @default(uuid())
  parentId    String?        @map("parent_id")
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?        @map("image_url")
  sortOrder   Int            @default(0) @map("sort_order")
  status      CategoryStatus @default(ACTIVE)
  // Seed catalog data, protected from edit/delete by anyone below SUPER_ADMIN
  // and exempt from the visitor-data TTL cleanup job.
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  categoryId      String        @map("category_id")
  // Plain optional label, not a managed entity — Zepto/Blinkit don't model brand
  // as a first-class schema either; some products carry one, most don't.
  brand           String?
  name            String
  slug            String        @unique
  description     String?
  ingredients     String?
  nutritionalInfo Json?         @map("nutritional_info")
  dietaryInfo     DietaryTag[]  @map("dietary_info")
  countryOfOrigin String?       @map("country_of_origin")
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false) @map("is_featured")
  // Seed catalog data — protection/exemption same as Category.isSystem.
  // Variants and images aren't flagged individually; they inherit protection
  // from their parent product to avoid a duplicated flag drifting out of sync.
  isSystem        Boolean       @default(false) @map("is_system")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status, isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String        @id @default(uuid())
  productId      String        @map("product_id")
  skuCode        String        @unique @map("sku_code")
  barcode        String?       @unique
  label          String
  quantity       Int
  unit           Unit
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  status         VariantStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  product              Product               @relation(fields: [productId], references: [id])
  inventory            Inventory?
  cartItems            CartItem[]
  orderItems           OrderItem[]
  checkoutReservations CheckoutReservation[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String    @id @default(uuid())
  variantId        String    @unique @map("variant_id")
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  reorderLevel     Int       @default(10) @map("reorder_level")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}

model Cart {
  id        String     @id @default(uuid())
  // Null for a guest cart, identified instead by the cart's own id carried
  // as an opaque value in an HTTP-only cookie — see AGENTS.md cart doc.
  userId    String?    @map("user_id")
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  user             User?             @relation(fields: [userId], references: [id])
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid())
  cartId    String    @map("cart_id")
  variantId String    @map("variant_id")
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @map("discount_type")
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  minOrderValue Decimal?  @map("min_order_value") @db.Decimal(10, 2)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  orders Order[]

  @@map("coupons")
}

model Order {
  id String @id @default(uuid())
  // Human-facing identifier (DB-YYYYMMDD-NNNNNN), generated from the
  // order_number_seq Postgres sequence at creation — the UUID id is never
  // shown to customers (dailybasket-orders-order-tracking.md §3).
  orderNumber String @unique @map("order_number")
  // Null for a guest order — see CheckoutSession for the same guest/user split as Cart.
  userId    String? @map("user_id")
  // Traceability only — the fields below are the authoritative snapshot per
  // AGENTS.md/checkout doc, since a saved address can change or be deleted later.
  addressId String? @map("address_id")
  couponId  String? @map("coupon_id")

  recipientName    String  @map("recipient_name")
  phone            String
  line1            String
  line2            String?
  landmark         String?
  city             String
  state            String
  country          String  @default("India")
  postalCode       String  @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String? @map("formatted_address")

  // Contact for a guest order — authenticated orders use user.email instead.
  guestEmail String? @map("guest_email")

  status      OrderStatus @default(CONFIRMED)
  subtotal    Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  tax         Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?   @updatedAt @map("updated_at") @db.Timestamptz

  user            User?            @relation(fields: [userId], references: [id])
  address         Address?         @relation(fields: [addressId], references: [id])
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payment         Payment?
  delivery        Delivery?
  events          OrderEvent[]
  checkoutSession CheckoutSession?

  @@map("orders")
}

model OrderEvent {
  id        String          @id @default(uuid())
  orderId   String          @map("order_id")
  type      OrderEventType
  // Free-text context — e.g. the cancellation reason.
  message   String?
  actorType OrderEventActor @map("actor_type")
  actorId   String?         @map("actor_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  variantId String @map("variant_id")

  // Snapshots — an order is a historical record, catalog data is mutable.
  productNameSnapshot String @map("product_name_snapshot")
  variantNameSnapshot String @map("variant_name_snapshot")
  skuSnapshot         String @map("sku_snapshot")

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  // Nullable + independently locatable via checkoutSessionId — a payment can
  // capture before the Order row exists (see checkout doc: "payment succeeds
  // but order creation fails must be recoverable").
  orderId           String?       @unique @map("order_id")
  checkoutSessionId String?       @unique @map("checkout_session_id")
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(10, 2)
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?     @updatedAt @map("updated_at") @db.Timestamptz

  order           Order?           @relation(fields: [orderId], references: [id])
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  @@map("payments")
}

model CheckoutSession {
  id         String                @id @default(uuid())
  cartId     String                @map("cart_id")
  userId     String?               @map("user_id")
  guestEmail String?               @map("guest_email")
  status     CheckoutSessionStatus @default(PENDING)

  // Address snapshot — set via POST /checkout/address, either copied from a
  // saved Address or guest-entered directly. Same shape as Order's snapshot.
  savedAddressId   String? @map("saved_address_id")
  recipientName    String? @map("recipient_name")
  phone            String?
  line1            String?
  line2            String?
  landmark         String?
  city             String?
  state            String?
  country          String? @default("India")
  postalCode       String? @map("postal_code")
  latitude         Float?
  longitude        Float?
  formattedAddress String? @map("formatted_address")

  subtotal    Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @default(0) @db.Decimal(10, 2)

  orderId String? @unique @map("order_id")

  // Session expiry (~15 min) and reservation expiry (~10 min) are separate
  // per the checkout doc — the reservation can lapse first, forcing
  // re-validation, even while the session itself is still alive.
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  reservationExpiresAt DateTime? @map("reservation_expires_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  cart         Cart                  @relation(fields: [cartId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])
  order        Order?                @relation(fields: [orderId], references: [id])
  payment      Payment?
  reservations CheckoutReservation[]

  @@index([userId])
  @@index([cartId])
  @@map("checkout_sessions")
}

model CheckoutReservation {
  id                String  @id @default(uuid())
  checkoutSessionId String  @map("checkout_session_id")
  variantId         String  @map("variant_id")
  quantity          Int
  // Price at the moment stock was reserved — this is what Razorpay actually
  // charged, so order creation reads it back instead of re-deriving from the
  // (possibly since-changed) live catalog price.
  unitPrice         Decimal @map("unit_price") @db.Decimal(10, 2)

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([checkoutSessionId, variantId])
  @@map("checkout_reservations")
}

model Delivery {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")

  // Nullable — no delivery-partner assignment flow exists yet
  // (dailybasket-delivery-partner-operations.md); set by that feature later.
  deliveryPartnerId String?        @map("delivery_partner_id")
  status            DeliveryStatus @default(PENDING)
  currentLatitude   Float?         @map("current_latitude")
  currentLongitude  Float?         @map("current_longitude")
  deliveryNotes     String?        @map("delivery_notes")

  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz
  pickingStartedAt DateTime? @map("picking_started_at") @db.Timestamptz
  packedAt         DateTime? @map("packed_at") @db.Timestamptz
  outForDeliveryAt DateTime? @map("out_for_delivery_at") @db.Timestamptz
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}
